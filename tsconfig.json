{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    // the JavaScript modules stay as they are, unchecked, until they are moved to TypeScript
    "allowJs": true,
    "checkJs": false,
    "paths": {
      "@/*": ["./src/*"],
      // swiper 9 has types, but its package exports hide them from the bundler resolution (until #4768)
      "swiper": ["./node_modules/swiper/swiper.d.ts"]
    },
    "types": ["vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.vue"],
  "exclude": ["dist", "node_modules"]
}
