{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    // the JavaScript modules stay as they are, unchecked, until they are moved to TypeScript
    "allowJs": true,
    "checkJs": false,
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["vite/client"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
