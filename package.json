{
  "name": "c2c_ui",
  "version": "7.37.0",
  "private": true,
  "description": "https://www.camptocamp.org user interface",
  "author": "Camptocamp community <dev@camptocamp.org>",
  "scripts": {
    "serve": "cross-env BUILD_ENV=local vite",
    "build": "cross-env BUILD_ENV=camptocamp vite build",
    "lint": "prettier --write \"**/*.{ts,js,mjs,json,css,scss,less,md,html,vue}\" && npm run lint:style && eslint --fix src \"*.mjs\"",
    "build:github": "cross-env BUILD_ENV=github vite build",
    "generate-icons": "node tools/generate-icons.js",
    "lint:no-fix": "prettier --check \"**/*.{ts,js,mjs,json,css,scss,less,md,html,vue}\" && npm run lint:style && eslint src \"*.mjs\"",
    "lint:style": "stylelint \"src/**/*.{vue,scss}\"",
    "test": "vitest run",
    "messages:extract": "node tools/extract-messages.js",
    "prepare": "husky && npm run prepare-swiper",
    "update-c2c-common": "python3 tools/update-c2c-common.py",
    "prepare-swiper": "concat -o ./public/swiper.css ./node_modules/swiper/modules/pagination/pagination-element.min.css ./node_modules/swiper/modules/navigation/navigation-element.min.css ./node_modules/swiper/modules/virtual/virtual-element.min.css ./node_modules/swiper/modules/zoom/zoom-element.min.css"
  },
  "dependencies": {
    "@c2corg/fit-parser-extract-geometry": "1.0.3",
    "@fortawesome/fontawesome-svg-core": "6.7.2",
    "@fortawesome/free-brands-svg-icons": "7.3.1",
    "@fortawesome/free-regular-svg-icons": "6.7.2",
    "@fortawesome/free-solid-svg-icons": "6.7.2",
    "@fortawesome/vue-fontawesome": "3.3.3",
    "@turf/boolean-intersects": "7.4.0",
    "@turf/buffer": "7.4.0",
    "@turf/difference": "7.4.0",
    "@turf/helpers": "7.4.0",
    "@turf/intersect": "7.4.0",
    "@turf/simplify": "7.4.0",
    "@vueform/slider": "2.1.10",
    "ag-grid-community": "36.2.0",
    "ag-grid-vue3": "36.2.0",
    "axios": "1.20.0",
    "blueimp-load-image": "5.16.0",
    "bulma": "0.9.4",
    "bulma-checkradio": "2.1.3",
    "bulma-switch": "2.0.4",
    "bulma-toast": "2.4.4",
    "core-js": "3.50.0",
    "d3": "7.9.0",
    "dayjs": "1.11.23",
    "dompurify": "^3.4.17",
    "file-saver": "2.0.5",
    "mitt": "3.0.1",
    "ol": "10.11.0",
    "swiper": "9.4.1",
    "uqr": "0.1.3",
    "vue": "3.5.44",
    "vue-multiselect": "3.5.0",
    "vue-router": "5.4.0",
    "zingtouch": "1.0.6"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@vitejs/plugin-legacy": "7.2.1",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "autoprefixer": "10.6.1",
    "concat": "1.0.3",
    "cross-env": "10.1.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "jsdom": "30.1.3",
    "postcss-html": "1.8.0",
    "prettier": "3.9.10",
    "prettier-plugin-jsdoc": "1.8.1",
    "pretty-quick": "4.2.2",
    "rollup-plugin-visualizer": "7.1.1",
    "sass": "1.105.2",
    "stylelint": "16.25.0",
    "stylelint-config-recommended-scss": "15.0.1",
    "stylelint-config-recommended-vue": "1.6.1",
    "stylelint-scss": "7.3.0",
    "vite": "7.3.7",
    "vitest": "5.0.5",
    "vue-eslint-parser": "10.4.1",
    "xml2js": "0.6.2"
  },
  "postcss": {
    "plugins": {
      "autoprefixer": {}
    }
  },
  "bugs": {
    "url": "https://forum.camptocamp.org/c/site-et-association/v6-suggestions-bugs-et-problemes",
    "email": "dev@camptocamp.org"
  },
  "homepage": "https://www.camptocamp.org",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/c2corg/c2c_ui.git"
  }
}
