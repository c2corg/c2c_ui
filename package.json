{
  "name": "c2c_ui",
  "version": "7.37.0",
  "private": true,
  "description": "https://www.camptocamp.org user interface",
  "author": "Camptocamp community <dev@camptocamp.org>",
  "scripts": {
    "serve": "cross-env BUILD_ENV=local vite",
    "build": "cross-env BUILD_ENV=camptocamp vite build",
    "lint": "prettier --write \"**/*.{ts,js,json,css,scss,less,md,html,vue}\" && npm run lint:style && eslint --ext .js,.vue src",
    "build:github": "cross-env BUILD_ENV=github vite build",
    "generate-icons": "node tools/generate-icons.js",
    "lint:no-fix": "prettier --check \"**/*.{ts,js,json,css,scss,less,md,html,vue}\" && npm run lint:style && eslint --ext .js,.vue src",
    "lint:style": "stylelint \"src/**/*.{vue,scss}\"",
    "messages:extract": "node tools/extract-messages.js",
    "prepare": "husky && npm run snyk-protect && npm run prepare-swiper",
    "snyk-protect": "snyk-protect",
    "update-c2c-common": "python3 tools/update-c2c-common.py",
    "prepare-swiper": "concat -o ./public/swiper.css ./node_modules/swiper/modules/pagination/pagination-element.min.css ./node_modules/swiper/modules/navigation/navigation-element.min.css ./node_modules/swiper/modules/virtual/virtual-element.min.css ./node_modules/swiper/modules/zoom/zoom-element.min.css"
  },
  "dependencies": {
    "@c2corg/fit-parser-extract-geometry": "1.0.3",
    "@fortawesome/fontawesome-free": "6.7.2",
    "@fortawesome/fontawesome-svg-core": "6.7.2",
    "@fortawesome/free-brands-svg-icons": "6.7.2",
    "@fortawesome/free-regular-svg-icons": "6.7.2",
    "@fortawesome/free-solid-svg-icons": "6.7.2",
    "@fortawesome/vue-fontawesome": "^3.0.0",
    "@turf/boolean-intersects": "7.3.0",
    "@turf/buffer": "7.3.0",
    "@turf/difference": "7.3.0",
    "@turf/intersect": "7.3.0",
    "@turf/simplify": "7.3.0",
    "@unhead/vue": "^2.0.0",
    "@vuepic/vue-datepicker": "^14.0.0",
    "ag-grid-community": "^36.0.0",
    "ag-grid-vue3": "^36.0.0",
    "axios": "1.13.2",
    "blueimp-load-image": "5.16.0",
    "bulma": "0.9.4",
    "bulma-checkradio": "2.1.3",
    "bulma-switch": "2.0.4",
    "bulma-toast": "2.4.4",
    "core-js": "3.47.0",
    "d3": "7.9.0",
    "dayjs": "1.11.19",
    "file-saver": "2.0.5",
    "mitt": "^3.0.1",
    "ol": "10.7.0",
    "process": "0.11.10",
    "swiper": "9.4.1",
    "uqr": "0.1.2",
    "vue": "^3.5.0",
    "vue-gtag": "^3.0.0",
    "vue-multiselect": "^3.0.0",
    "vue-router": "^4.5.0",
    "vue-slider-component": "4.1.0-beta.7",
    "zingtouch": "1.0.6"
  },
  "devDependencies": {
    "@snyk/protect": "1.1300.2",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/eslint-config-standard": "^8.0.0",
    "autoprefixer": "^10.5.4",
    "concat": "1.0.3",
    "cross-env": "10.1.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-custom-alias": "1.3.2",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-node": "11.1.0",
    "eslint-plugin-prettier": "4.2.5",
    "eslint-plugin-promise": "^6.0.0",
    "eslint-plugin-vue": "^9.0.0",
    "husky": "9.1.7",
    "postcss-html": "1.8.0",
    "prettier": "2.8.8",
    "prettier-plugin-jsdoc": "0.4.2",
    "pretty-quick": "3.3.1",
    "rollup-plugin-visualizer": "^5.12.0",
    "sass": "1.94.1",
    "stylelint": "16.25.0",
    "stylelint-config-recommended-scss": "15.0.1",
    "stylelint-config-recommended-vue": "1.6.1",
    "stylelint-scss": "6.12.1",
    "vite": "^6.0.0",
    "xml2js": "0.6.2"
  },
  "postcss": {
    "plugins": {
      "autoprefixer": {}
    }
  },
  "bugs": {
    "url": "https://forum.camptocamp.org/c/site-et-association/v6-suggestions-bugs-et-problemes",
    "email": "dev@camptocamp.org"
  },
  "homepage": "https://www.camptocamp.org",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/c2corg/c2c_ui.git"
  },
  "snyk": true
}
