{
  "root": true,
  "env": {
    "node": true
  },
  "extends": [
    "plugin:vue/recommended",
    "plugin:import/errors",
    "plugin:import/warnings",
    "plugin:prettier/recommended"
  ],
  "reportUnusedDisableDirectives": true,
  "rules": {
    "prettier/prettier": ["warn", { "endOfLine": "auto" }],
    "no-unused-vars": "warn",
    "no-console": "warn",
    "vue/no-v-html": "off",
    "vue/order-in-components": "warn",
    "vue/require-prop-types": "warn",
    "vue/require-default-prop": "warn",
    "vue/attributes-order": "off",
    "vue/multi-word-component-names": "off",
    "vue/no-mutating-props": "off",
    "vue/no-use-v-if-with-v-for": "error",
    "vue/prop-name-casing": ["error", "camelCase"],
    "eqeqeq": "warn",
    "camelcase": "off",
    "import/order": [
      "error",
      { "newlines-between": "always", "alphabetize": { "order": "asc", "caseInsensitive": false } }
    ]
  },
  "settings": {
    "import/resolver": {
      "node": {
        "extensions": [".js", ".vue"]
      },
      "custom-alias": {
        "alias": {
          "@": "./src"
        },
        "extensions": [".js", ".vue"]
      }
    }
  },
  "parserOptions": {
    "parser": "@babel/eslint-parser",
    "requireConfigFile": false,
    "sourceType": "module"
  },
  "overrides": [
    {
      "files": ["src/**/*.vue", "src/**/*.js"],
      "rules": {
        "vue/no-deprecated-data-object-declaration": "warn",
        "vue/no-deprecated-delete-set": "warn",
        "vue/no-deprecated-dollar-listeners-api": "warn",
        "vue/no-deprecated-events-api": "warn",
        "vue/no-deprecated-filter": "warn",
        "vue/no-deprecated-functional-template": "warn",
        "vue/no-deprecated-html-element-is": "warn",
        "vue/no-deprecated-inline-template": "warn",
        "vue/no-deprecated-model-definition": "warn",
        "vue/no-deprecated-props-default-this": "warn",
        "vue/no-deprecated-router-link-tag-prop": "warn",
        "vue/no-deprecated-scope-attribute": "warn",
        "vue/no-deprecated-slot-attribute": "warn",
        "vue/no-deprecated-slot-scope-attribute": "warn",
        "vue/no-deprecated-v-is": "warn",
        "vue/no-deprecated-v-on-native-modifier": "warn",
        "vue/no-deprecated-v-on-number-modifiers": "warn",
        "vue/no-deprecated-vue-config-keycodes": "warn",
        "vue/require-explicit-emits": "warn"
      }
    },
    {
      "files": ["vite.config.mjs", "vitest.config.mjs", "src/**/*.spec.js"],
      "rules": {
        "import/no-unresolved": ["error", { "ignore": ["^vitest(/|$)", "^@vitejs/plugin-legacy$"] }]
      }
    }
  ]
}
